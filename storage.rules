rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function validPublicId(publicId) {
      return publicId.matches('^[a-z0-9]{12}$');
    }

    function ownsPublicId(publicId) {
      return request.auth != null
        && validPublicId(publicId)
        && firestore.get(
          /databases/(default)/documents/collectorPublicIdOwners/$(publicId)
        ).data.ownerUid == request.auth.uid;
    }

    // 새 사진 반영 뒤 이전 파일을 지울 수 있도록 a/b 두 슬롯만 허용합니다.
    // 공개 URL에는 UID 대신 publicId만 포함하고, 비공개 Firestore 소유권
    // 문서로 업로드·교체·삭제 권한을 확인합니다.
    match /publicProfiles/{publicId}/{avatarFile} {
      allow read: if validPublicId(publicId)
        && avatarFile.matches('^avatar-[ab][.]webp$');
      allow create, update: if ownsPublicId(publicId)
        && avatarFile.matches('^avatar-[ab][.]webp$')
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == "image/webp";
      allow delete: if ownsPublicId(publicId)
        && avatarFile.matches('^avatar-[ab][.]webp$');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
